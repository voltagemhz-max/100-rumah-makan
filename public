<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Restoran</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header>
        <div class="logo">RM RESTORAN</div>
        <nav class="nav-menu" id="nav">
            <a href="#home">Home</a>
            <a href="#pelanggan">Pelanggan</a>
            <a href="#karyawan">Karyawan</a>
            <a href="#makanan">Makanan</a>
            <a href="#minuman">Minuman</a>
            <a href="#meja">Meja</a>
            <a href="#pesanan">Pesanan</a>
            <a href="#pembayaran">Pembayaran</a>
        </nav>
    </header>

    <main class="main-container">
        <div class="page-head">
            <h2 id="title"></h2>
            <button class="btn" id="add" hidden></button>
        </div>
        <p id="summary" class="summary" hidden></p>
        <div id="content"></div>
    </main>

    <dialog id="dlg">
        <form id="frm" method="dialog">
            <h3 id="dlgTitle"></h3>
            <div id="fields"></div>
            <p id="err" class="err" role="alert"></p>
            <div class="actions">
                <button type="button" class="btn ghost" id="cancel">Batal</button>
                <button type="submit" class="btn">Simpan</button>
            </div>
        </form>
    </dialog>

    <script src="script.js"></script>
</body>
</html>
